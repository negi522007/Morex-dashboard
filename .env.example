DATABASE_URL=postgresql://dashboard:dashboard@db:5432/dashboard
APP_URL=http://localhost:8080
# Where "Sign in with GitHub" redirects back to once it's done (success or
# failure) — the frontend dev server by default.
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_NAME=dashboard_session
# Set to "true" only once the app is actually served over HTTPS (a browser
# silently drops Secure cookies on plain HTTP, which is what docker-compose
# serves today).
COOKIE_SECURE=false
# 32-byte hex key for encrypting stored OAuth tokens (AES-256-GCM). Generate
# your own with: openssl rand -hex 32 — never reuse this example value.
TOKEN_ENCRYPTION_KEY=

# Defaults point at the Mailhog container from docker-compose.yml (no auth
# needed, no real inbox — open http://localhost:8025 to read what was
# "sent"). docker-compose.yml does NOT override these, so replacing them
# with a real provider's values here is enough for real delivery — see
# CONTRIBUTING.md's "Sending real confirmation emails" for a Gmail-based
# walkthrough (works with any provider that supports SMTP app passwords).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=dashboard@localhost

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8080/auth/github/callback

# Comma-separated emails auto-promoted to admin AT REGISTRATION TIME only
# (checked once, when the account is created — changing this later does
# nothing for accounts that already exist). No API endpoint promotes a user
# to admin; for an existing account, it's a direct DB edit:
#   UPDATE "User" SET "isAdmin" = true WHERE email = '...';
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# AI (optional). Everything works without it; AI only adds opt-in extras
# (article recaps, widget insights, daily brief, widget assistant).
# The key stays on the server: never put it in the frontend or commit it.
# ---------------------------------------------------------------------------
# anthropic | openai-compatible | mock   (empty = AI off)
#   mock = offline canned answers, for developing the UI without a key.
# FREE options (all use AI_PROVIDER=openai-compatible; free tiers have rate limits,
# the per-user cap below keeps you well inside them; check each provider's current
# model names and limits, they change):
#   Google Gemini : AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                   AI_MODEL=gemini-2.5-flash        (key: aistudio.google.com/apikey)
#   Groq          : AI_BASE_URL=https://api.groq.com/openai/v1
#                   AI_MODEL=llama-3.3-70b-versatile (key: console.groq.com)
#   OpenRouter    : AI_BASE_URL=https://openrouter.ai/api/v1
#                   AI_MODEL=<a model ending in ":free">
#   Ollama (local, no key, no data leaves your machine; from Docker use host.docker.internal):
#                   AI_BASE_URL=http://host.docker.internal:11434/v1  AI_MODEL=qwen2.5:7b  AI_API_KEY=ollama
AI_PROVIDER=
AI_API_KEY=
# Optional. Defaults: claude-haiku-4-5-20251001 (anthropic) / gpt-4o-mini (openai-compatible)
AI_MODEL=
# openai-compatible only, e.g. https://api.openai.com/v1 or a local Ollama http://host:11434/v1
AI_BASE_URL=
AI_TIMEOUT_MS=30000
# Per-user daily cap of model calls, so one account cannot drain the key.
AI_DAILY_CALLS_PER_USER=60

# ---------------------------------------------------------------------------
# Server-side fetching of user-supplied URLs (RSS feeds, calendar links,
# custom API widgets) is blocked for private/loopback/link-local addresses
# (SSRF protection). Set to "true" ONLY on a local dev machine if you need to
# point a widget at a service on your own network. Never in production.
# ---------------------------------------------------------------------------
ALLOW_PRIVATE_FETCH=false

# ---------------------------------------------------------------------------
# "Connect / Sign in with My Epitech" (OpenID Connect; the student logs in
# with their Microsoft account on Epitech's side). An Epitech staff member
# must declare the app first — see API.md "My Epitech".
# ---------------------------------------------------------------------------
EPITECH_OIDC_CLIENT_ID=
EPITECH_OIDC_CLIENT_SECRET=
EPITECH_OIDC_CALLBACK_URL=http://localhost:8080/auth/epitech/callback
# Only change if Epitech moves its OIDC issuer.
EPITECH_OIDC_DISCOVERY_URL=https://my.epitech.eu/api/oidc/.well-known/openid-configuration

# YouTube Data API v3 (public data, no user account needed) — Google Cloud Console:
# create a project, enable "YouTube Data API v3", then Credentials → Create credentials → API key.
# Restrict the key to "YouTube Data API v3". Quota: 10,000 units/day, each widget refresh costs 1–3.
YOUTUBE_API_KEY=
