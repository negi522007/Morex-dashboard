# Everything in this file is OPTIONAL: `docker compose up --build` works with no .env at all.
DATABASE_URL=postgresql://dashboard:dashboard@db:5432/dashboard
# Confirmation-link base. localhost only works for whoever runs the server: to let someone else
# (a phone, another PC on the same Wi-Fi) confirm their own signup, put your machine's LAN IP here
# instead, e.g. APP_URL=http://192.168.1.23:8080 (find it with `ip addr` / `ipconfig`), then also set
# FRONTEND_URL below to that same IP on port 5173, restart with
# `docker compose up -d --force-recreate server frontend`, and open http://<that IP>:5173 on the other
# device. For anyone outside your network, use a public URL or a tunnel instead (see TROUBLESHOOTING.md).
APP_URL=http://localhost:8080
# Where "Sign in with GitHub"/Microsoft/My Epitech redirect back to, and where the confirmation page's
# "Sign in" button points — the frontend, reachable from wherever the link is opened (see APP_URL above).
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_NAME=dashboard_session
# Set to "true" only once the app is actually served over HTTPS (a browser
# silently drops Secure cookies on plain HTTP, which is what docker-compose
# serves today).
COOKIE_SECURE=false
# 32-byte hex key for encrypting stored OAuth tokens (AES-256-GCM). Leave empty and
# the server generates one (kept in a Docker volume). To choose your own:
# openssl rand -hex 32 — never reuse an example value, never change it once data exists.
TOKEN_ENCRYPTION_KEY=

# Defaults point at the Mailhog container from docker-compose.yml (no auth
# needed, no real inbox — open http://localhost:8025 to read what was
# "sent"). docker-compose.yml does NOT override these, so replacing them
# with a real provider's values here is enough for real delivery — see
# CONTRIBUTING.md's "Sending real confirmation emails" for a Gmail-based
# walkthrough (works with any provider that supports SMTP app passwords).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=dashboard@localhost

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8080/auth/github/callback

# Comma-separated emails auto-promoted to admin AT REGISTRATION TIME only
# (checked once, when the account is created — changing this later does
# nothing for accounts that already exist). No API endpoint promotes a user
# to admin; for an existing account, it's a direct DB edit:
#   UPDATE "User" SET "isAdmin" = true WHERE email = '...';
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# AI (optional). Everything works without it; AI only adds opt-in extras
# (article recaps, widget insights, daily brief, widget assistant).
# The key stays on the server: never put it in the frontend or commit it.
# ---------------------------------------------------------------------------
# anthropic | openai-compatible | mock   (empty = AI off)
#   mock = canned, meaningless answers for developing without a key. Ignored in Docker (production)
#   unless AI_ALLOW_MOCK=true — never use it for a demo: it is not real AI.
# FREE options (all use AI_PROVIDER=openai-compatible). Model names and limits change often:
# check the provider's page before relying on them. Checked Sept 2026:
#   Google Gemini (recommended to start; no card needed; key: aistudio.google.com/apikey)
#       AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#       AI_MODEL=gemini-3.5-flash-lite   (cheapest/fastest; gemini-3.8-flash = better quality)
#       AI_REASONING_EFFORT=low          (thinking can't be switched off on Gemini 3; low keeps room for the answer)
#       Free-tier prompts may be used by Google to improve its products.
#   Groq (key: console.groq.com). Free plan: 30 requests/min, 1,000/day, 8,000 tokens/min, 200,000 tokens/day
#       AI_BASE_URL=https://api.groq.com/openai/v1
#       AI_MODEL=openai/gpt-oss-20b      (or openai/gpt-oss-120b)   AI_REASONING_EFFORT=low
#   OpenRouter: models whose id ends in ":free" — 20 requests/min, only 50/day until you have bought credits
#       AI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama (local, no key, nothing leaves your machine; from Docker use host.docker.internal):
#       AI_BASE_URL=http://host.docker.internal:11434/v1  AI_MODEL=qwen2.5:7b  AI_API_KEY=ollama
AI_PROVIDER=openai-compatible; free tiers have rate limits,
# the per-user cap below keeps you well inside them; check each provider's current
# model names and limits, they change):
#   Google Gemini : AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                   AI_MODEL=gemini-2.5-flash        (key: aistudio.google.com/apikey)
#   Groq          : AI_BASE_URL=https://api.groq.com/openai/v1
#                   AI_MODEL=llama-3.3-70b-versatile (key: console.groq.com)
#   OpenRouter    : AI_BASE_URL=https://openrouter.ai/api/v1
#                   AI_MODEL=<a model ending in ":free">
#   Ollama (local, no key, no data leaves your machine; from Docker use host.docker.internal):
#                   AI_BASE_URL=http://host.docker.internal:11434/v1  AI_MODEL=qwen2.5:7b  AI_API_KEY=ollama
AI_PROVIDER=
AI_API_KEY=
# Optional. Defaults: claude-haiku-4-5-20251001 (anthropic) / gpt-4o-mini (openai-compatible)
AI_MODEL=
# openai-compatible only, e.g. https://api.openai.com/v1 or a local Ollama http://host:11434/v1
AI_BASE_URL=
# Optional: low | medium | high. Set it for reasoning models (see above); leave empty for ordinary ones.
AI_REASONING_EFFORT=
AI_TIMEOUT_MS=30000
# Per-user daily cap of model calls, so one account cannot drain the key.
AI_DAILY_CALLS_PER_USER=60

# ---------------------------------------------------------------------------
# Server-side fetching of user-supplied URLs (RSS feeds, calendar links,
# custom API widgets) is blocked for private/loopback/link-local addresses
# (SSRF protection). Set to "true" ONLY on a local dev machine if you need to
# point a widget at a service on your own network. Never in production.
# ---------------------------------------------------------------------------
ALLOW_PRIVATE_FETCH=false

# ---------------------------------------------------------------------------
# "Connect / Sign in with My Epitech" (OpenID Connect; the student logs in
# with their Microsoft account on Epitech's side). An Epitech staff member
# must declare the app first — see API.md "My Epitech".
# ---------------------------------------------------------------------------
EPITECH_OIDC_CLIENT_ID=
EPITECH_OIDC_CLIENT_SECRET=
EPITECH_OIDC_CALLBACK_URL=http://localhost:8080/auth/epitech/callback
# Only change if Epitech moves its OIDC issuer.
EPITECH_OIDC_DISCOVERY_URL=https://my.epitech.eu/api/oidc/.well-known/openid-configuration

# YouTube Data API v3 (public data, no user account needed) — Google Cloud Console:
# create a project, enable "YouTube Data API v3", then Credentials → Create credentials → API key.
# Restrict the key to "YouTube Data API v3". Quota: 10,000 units/day, each widget refresh costs 1–3.
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# "Sign in with your school Microsoft account" (OpenID Connect, no My Epitech staff needed).
# You register the app yourself in the Microsoft Entra admin center — see API.md → "Microsoft sign-in".
# Only accounts of ONE organisation are accepted (default epitech.eu): its tenant is looked up
# automatically from Microsoft's public metadata.
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:8080/auth/microsoft/callback
MICROSOFT_ALLOWED_DOMAIN=epitech.eu

# Steam Web API key (free: https://steamcommunity.com/dev/apikey — needs a Steam account). Read-only,
# public profiles only. Without it the Steam widgets can be created but stay empty.
STEAM_API_KEY=

# The confirmation-email page ("Is this you?") is served by the backend. To use your own frontend page
# instead, put its URL here (it receives ?token=…) — see FRONTEND.md → Confirmation page.
CONFIRM_PAGE_URL=
# Set to "true" once the register form asks for a date of birth, to make it mandatory on the API.
REQUIRE_BIRTH_DATE=false
