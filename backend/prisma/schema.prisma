generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  emailVerified Boolean  @default(false)
  // Set only via ADMIN_EMAILS at registration time, or a direct DB edit —
  // there is deliberately no API endpoint to promote a user to admin
  // (privilege-escalation surface not worth the convenience).
  isAdmin       Boolean  @default(false)
  // Blocks login and kills every existing Session row the moment it's set
  // (see AdminService.ban) — instant, unlike a JWT-based approach would be.
  isBanned      Boolean  @default(false)

  // Profile/preferences (Morex dashboard UI) — all optional/defaulted so
  // existing accounts don't need a backfill.
  bio             String?
  // Optional date of birth (day precision, no time zone). Collected at sign-up and used only to
  // compute the zodiac sign for the well-being page; never sent anywhere, never shown to others.
  birthDate       DateTime? @db.Date
  theme           String  @default("galaxy")
  language        String  @default("en")
  widgetSkin      String  @default("glass")
  // DiceBear "avataaars" option object, rendered client-side into a URL —
  // no image is ever generated or stored server-side for this path.
  avatarConfig    Json?
  // Set when a real photo was uploaded (see AuthController's avatar
  // endpoints); takes priority over avatarConfig when present. Stored as a
  // path relative to the uploads volume, never a full URL (host-independent).
  avatarPhotoPath String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions                 Session[]
  oauthAccounts            OAuthAccount[]
  serviceSubscriptions     ServiceSubscription[]
  widgetInstances          WidgetInstance[]
  emailVerificationTokens  EmailVerificationToken[]
  journalEntries           JournalEntry[]
  alerts                   Alert[]
  shareLink                ShareLink?
  aiUsage                  AiUsage[]
  briefs                   Brief[]
}

// Server-side session (not a JWT): the id is the unguessable value stored in
// the httpOnly session cookie. Deleting a row logs that session out instantly —
// this is what makes admin-initiated bans/logouts immediate.
model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// A third-party account linked to a platform user (OAuth authorization).
// Linking is resolved by matching the provider's verified email against
// an existing User — never create a duplicate User on OAuth login.
model OAuthAccount {
  id                     String  @id @default(uuid())
  provider               String
  providerAccountId      String
  accessTokenEncrypted   String
  refreshTokenEncrypted  String?
  // Non-secret, provider-specific facts (e.g. My Epitech: login, campus,
  // promotion, cursus, group) — shown to the user, never a credential.
  profile                Json?
  userId                 String
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Non-OAuth service subscription (e.g. username/password based service).
model ServiceSubscription {
  id                    String   @id @default(uuid())
  serviceName           String
  credentialsEncrypted  String?
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())

  @@unique([userId, serviceName])
}

model WidgetInstance {
  id                 String    @id @default(uuid())
  serviceName        String
  widgetName         String
  config             Json
  refreshRateSeconds Int
  position           Json
  // User-chosen display title, overriding the default widgetName label when
  // set; and a purely cosmetic sticker overlay (see frontend deco.ts) — both
  // optional, neither affects fetchData.
  title              String?
  decoration         String?
  lastRefreshedAt    DateTime?
  cachedData         Json?
  // The exact reason the last refresh failed (e.g. "GitHub API returned HTTP 404"), shown on the card
  // instead of an indefinite "waiting for data" — cleared back to null the moment a refresh succeeds.
  lastError          String?
  // Opt-in (per widget) AI enrichment: `insight` holds the model's output next
  // to — never inside — cachedData, so cachedData's shape stays stable.
  // insightHash is a hash of the data the insight was made from: no new AI call
  // until the data actually changes.
  aiEnabled          Boolean   @default(false)
  insight            Json?
  insightAt          DateTime?
  insightHash        String?
  // Opt-in: appears on the user's public read-only link (see ShareLink).
  shared             Boolean   @default(false)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  snapshots          WidgetSnapshot[]
  alerts             Alert[]
}

// A private journal entry. Text is encrypted at rest (AES-256-GCM, same
// utility as OAuth tokens) — explicitly private content, same care level.
model JournalEntry {
  id            String   @id @default(uuid())
  date          DateTime
  mood          String
  textEncrypted String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// The value a widget is "about" (a rate, a temperature...), sampled on refresh
// so trends don't depend on what an upstream API keeps.
model WidgetSnapshot {
  id       String         @id @default(uuid())
  widgetId String
  widget   WidgetInstance @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  at       DateTime       @default(now())
  value    Float

  @@index([widgetId, at])
}

// "Tell me when this widget's value goes above/below X". Detection is plain
// arithmetic on the widget's primary metric — no AI involved.
model Alert {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgetId         String
  widget           WidgetInstance @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  label            String?
  operator         String // "above" | "below"
  threshold        Float
  cooldownMinutes  Int            @default(60)
  active           Boolean        @default(true)
  lastTriggeredAt  DateTime?
  createdAt        DateTime       @default(now())

  events           AlertEvent[]

  @@index([widgetId])
  @@index([userId])
}

model AlertEvent {
  id      String   @id @default(uuid())
  alertId String
  alert   Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  at      DateTime @default(now())
  value   Float
  message String

  @@index([alertId, at])
}

// One public read-only link per user. Rotating it (POST /share again) kills the old URL.
model ShareLink {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Per-user, per-day count of AI calls — the daily cap that keeps a key from being drained.
model AiUsage {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String // YYYY-MM-DD (UTC)
  calls  Int    @default(0)

  @@unique([userId, day])
}

// Summaries of PUBLIC content (an article), shared by every user who reads it:
// one model call per article+language, not one per user per refresh.
model ContentDigest {
  key       String   @id
  payload   Json
  createdAt DateTime @default(now())
}

// Addresses whose owner clicked "this wasn't me" on a confirmation email: sign-ups with a password are
// refused for a while, so nobody can keep mailing them.
model BlockedEmail {
  email     String   @id
  until     DateTime
  createdAt DateTime @default(now())
}

model Brief {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day         String
  language    String
  content     Json
  generatedAt DateTime @default(now())

  @@unique([userId, day, language])
}
