server {
  # NGINX_PORT is substituted the same way BACKEND_ORIGIN is — defaults to 80 (both docker-compose.yml
  # and frontend/Dockerfile set it explicitly), but the combined deploy image (deploy/start.sh) sets it
  # dynamically to whatever the hosting platform's own $PORT happens to be, since some platforms (Render
  # included) always inject one and route public traffic there regardless of what this image declares —
  # nginx has to actually be the thing listening on it, not just the backend next door guessing right.
  listen ${NGINX_PORT};
  root /usr/share/nginx/html;
  client_max_body_size 6m;   # avatar uploads

  # Every backend route prefix — keep in sync with vite.config.ts's dev proxy.
  location ~ ^/(auth|widgets|journal|uploads|services|ai|brief|assistant|alerts|share|public|admin/users|admin/service-stats|helpdesk|docs|docs-json|about\.json) {
    # BACKEND_ORIGIN is substituted by the nginx base image's own envsubst-on-templates
    # entrypoint (this file lives at /etc/nginx/templates/default.conf.template) — docker-compose.yml
    # sets it to http://server:8080 (the Compose service name); a split-host deploy (e.g. Render, where
    # frontend and backend are two separate services with no shared "server" hostname) sets it to the
    # backend service's own public HTTPS URL instead. Never hardcode either here.
    proxy_pass ${BACKEND_ORIGIN};
    # Deliberately NOT forwarding the original client Host here (unlike a typical reverse proxy): when
    # BACKEND_ORIGIN is an external host (e.g. Render), the platform in front of it routes by the Host
    # header / SNI of the backend's OWN hostname — sending the frontend's hostname instead causes a 502
    # (wrong-service routing), which is exactly what broke the first split-host deploy. Omitting this
    # line lets nginx default to $proxy_host (the host from proxy_pass itself) on every target, Compose
    # or external; the backend never reads the Host header for anything (APP_URL/FRONTEND_URL are
    # explicit env vars, not inferred from it), so this is safe either way.
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-For $remote_addr;
  }

  # Single-page app: unknown paths (/login, /dashboard…) serve index.html.
  location / {
    try_files $uri /index.html;
  }
}
